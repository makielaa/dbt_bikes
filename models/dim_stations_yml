version: 2

models:
  - name: dim_stations
    columns:
      - name: station_id
        tests: [unique, not_null]
      - name: bydel_name
        tests: [not_null]

  # add under your existing mart_stations entry (or in a new entry with this name):
  - name: mart_stations
    tests:
      - dbt_utils.unique_combination_of_columns:   # needs dbt_utils; remove if you don't use it
          combination_of_columns: [station_id, trip_month_date]
    columns:
      - name: station_id
        tests:
          - relationships:
              to: ref('dim_stations')
              field: station_id